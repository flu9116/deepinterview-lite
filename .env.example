# Development fallback only. Never distribute your real .env.
# Desktop Settings stores user credentials with Windows DPAPI; it takes priority after saving.
# LiveKit Cloud (practice mode only)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Deepgram (required for cloud transcription, not for local recording)
DEEPGRAM_API_KEY=

# OpenAI-compatible LLM (required for AI hints/review/practice, not local recording)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
# Extra background draft requests; false keeps final hints and necessary semantic checks.
ASSIST_DRAFTS=true

# Experiment switches
# nova-2-ja | nova-3-multi
STT_PROFILE=nova-3-multi
# audio | semantic | vad | stt | manual
EOU_MODE=audio
DEEPGRAM_ENDPOINTING_MS=300
EOU_MIN_DELAY_MS=300
EOU_MAX_DELAY_MS=2500

# Local Kokoro Python sidecar
KOKORO_URL=http://127.0.0.1:8787
KOKORO_VOICE=jf_alpha
KOKORO_SPEED=1

# Minimal local debug server
PORT=3001
ROOM_NAME=deepinterview-poc

